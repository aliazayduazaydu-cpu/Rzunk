-- ===== تأثيرات =====
local function tween(obj, time, props, style, dir)
	local t = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function toggleMenu()
	menuOpen = not menuOpen
	if menuOpen then
		frame.Visible = true
		frame.Size = UDim2.new(0, 0, 0, 0)
		tween(frame, 0.35, {Size = FRAME_SIZE}, Enum.EasingStyle.Back)
	else
		local t = tween(frame, 0.25, {Size = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		t.Completed:Connect(function()
			if not menuOpen then frame.Visible = false end
		end)
	end
end

toggleMenuBtn.MouseButton1Click:Connect(toggleMenu)

local function addHover(btn)
	btn.MouseEnter:Connect(function()
		tween(btn, 0.15, {Size = UDim2.new(1, 4, 0, 38)})
	end)
	btn.MouseLeave:Connect(function()
		tween(btn, 0.15, {Size = UDim2.new(1, 0, 0, 36)})
	end)
end
