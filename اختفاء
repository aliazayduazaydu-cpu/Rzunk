distBox.FocusLost:Connect(function()
	local value = tonumber(distBox.Text)
	if not value then
		distBox.Text = tostring(distance)
		return
	end
	distance = math.clamp(math.floor(math.abs(value)), 1, MAX_DISTANCE)
	distBox.Text = tostring(distance)
	refreshStatus()
end)

speedBox.FocusLost:Connect(function()
	local value = tonumber(speedBox.Text)
	if not value then
		speedBox.Text = tostring(speed)
		return
	end
	speed = math.clamp(math.floor(math.abs(value)), 1, MAX_SPEED)
	speedBox.Text = tostring(speed)
	refreshStatus()
end)

-- الضغط على الشاشة أثناء أداة الانتقال
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or not teleportOn then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		teleportTo(input.Position.X, input.Position.Y)
	end
end)

UserInputService.JumpRequest:Connect(function()
	if floatOn then
		jumpOffset = JUMP_HEIGHT
	end
end)

RunService.Stepped:Connect(function()
	if floatOn or rising then
		disableCollide()
	end
end)

-- ===== التحديث كل فريم =====
RunService.RenderStepped:Connect(function(dt)
	if not character or not root or not humanoid then return end
	if not (floatOn or rising) then return end

	local cf = root.CFrame
	local rot = cf - cf.Position

	if floatOn then
		local delta = humanoid.MoveDirection * speed * dt
		if delta.Magnitude > 0 then
			tryMove(delta)
		end

		local top = probeTop(markerX, markerZ)
		local target = math.max(baseY, top)
		if target > markerY then
			markerY = target
		else
			markerY = math.max(target, markerY - FALL_SPEED * dt)
		end

		jumpOffset = math.max(0, jumpOffset - JUMP_RECOVER * dt)

		local markerDrawY = markerY + jumpOffset
		root.CFrame = CFrame.new(markerX, markerDrawY - distance, markerZ) * rot
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		if marker then
			marker.CFrame = CFrame.new(markerX, markerDrawY, markerZ)
		end

	elseif rising then
		targetRootY = math.max(baseY, probeTop(markerX, markerZ) + 3)
		rootY = math.min(rootY + ASCEND_SPEED * dt, targetRootY)
		root.CFrame = CFrame.new(markerX, rootY, markerZ) * rot
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		if rootY >= targetRootY then
			finishRise()
		end
	end
end)

-- ===== عند الموت أو الظهور من جديد =====
local function onCharacterAdded(char)
	character = char
	humanoid = char:WaitForChild("Humanoid")
	root = char:WaitForChild("HumanoidRootPart")

	savedCollide = {}
	floatOn = false
	rising = false
	jumpOffset = 0
	removeMarker()
	setCameraFree(false)
	setBtn(false)
	refreshStatus()
end

player.CharacterAdded:Connect(onCharacterAdded)
if player.Character then
	task.spawn(onCharacterAdded, player.Character)
end
