-- ===== دوال مساعدة =====
local function setBtn(on)
	floatBtn.Text = "نزول وطفو: " .. (on and "ON" or "OFF")
	floatBtn.BackgroundColor3 = on and Color3.fromRGB(0, 140, 70) or Color3.fromRGB(50, 50, 50)
end

local function setTeleportBtn(on)
	teleportBtn.Text = "أداة الانتقال: " .. (on and "ON" or "OFF")
	teleportBtn.BackgroundColor3 = on and Color3.fromRGB(140, 70, 140) or Color3.fromRGB(70, 70, 140)
end

local function refreshStatus()
	if floatOn then
		statusLbl.Text = "طافي - المسافة: " .. distance .. " | السرعة: " .. speed
	elseif rising then
		statusLbl.Text = "جاري الصعود..."
	else
		statusLbl.Text = "الحالة: على السطح"
	end
end

local function createMarker()
	if marker then marker:Destroy() end
	marker = Instance.new("Part")
	marker.Name = "PositionMarker"
	marker.Anchored = true
	marker.CanCollide = false
	marker.CanQuery = false
	marker.CanTouch = false
	marker.Material = Enum.Material.Neon
	marker.Color = Color3.fromRGB(255, 0, 0)
	marker.Transparency = 0
	marker.Size = MARKER_SIZE
	marker.CFrame = CFrame.new(markerX, markerY, markerZ)
	marker.Parent = workspace
	rayParams.FilterDescendantsInstances = {character, marker}
	overlapParams.FilterDescendantsInstances = {character, marker}
end

local function removeMarker()
	if marker then
		marker:Destroy()
		marker = nil
	end
end

local function disableCollide()
	if not character then return end
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			if savedCollide[part] == nil then
				savedCollide[part] = part.CanCollide
			end
			part.CanCollide = false
		end
	end
end

local function restoreCollide()
	for part, original in pairs(savedCollide) do
		if part and part.Parent then
			part.CanCollide = original
		end
	end
	savedCollide = {}
end

local function setCameraFree(on)
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	if on and marker then
		cam.CameraSubject = marker
	elseif humanoid then
		cam.CameraSubject = humanoid
	end
end

-- أرض المربع: أعلى سطح تحته مباشرة
local function probeTop(x, z)
	local result = workspace:Blockcast(
		CFrame.new(x, markerY + 1, z),
		MARKER_SIZE,
		Vector3.new(0, -600, 0),
		rayParams
	)
	if result then
		return result.Position.Y
	end
	return -math.huge
end

-- أعلى نقطة لأي جزء داخل العمود أمام المربع
local function blockingTop(x, z)
	local parts = workspace:GetPartBoundsInBox(
		CFrame.new(x, markerY + 20.5, z),
		COLUMN_SIZE,
		overlapParams
	)
	local highest = nil
	for _, p in ipairs(parts) do
		if p.CanCollide then
			local t = p.Position.Y + p.Size.Y / 2
			if not highest or t > highest then
				highest = t
			end
		end
	end
	return highest
end

-- الحركة: يتوقف عند الجدران الطويلة، ويصعد على القصيرة
local function tryMove(delta)
	local nx = markerX + delta.X
	local nz = markerZ + delta.Z

	local top = blockingTop(nx, nz)

	if not top or top <= markerY + 0.5 then
		markerX, markerZ = nx, nz
		return
	end

	if top - markerY <= STEP_HEIGHT then
		markerX, markerZ = nx, nz
		markerY = top + MARKER_SIZE.Y / 2
	end
end

-- أداة الانتقال: ينتقل المربع مباشرة إلى النقطة التي تضغط عليها
local function teleportTo(screenX, screenY)
	if not floatOn or not marker then return end

	local cam = workspace.CurrentCamera
	local ray = cam:ViewportPointToRay(screenX, screenY)
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 2000, rayParams)
	if not hit then return end

	markerX = hit.Position.X
	markerZ = hit.Position.Z
	markerY = hit.Position.Y + MARKER_SIZE.Y / 2
	jumpOffset = 0
end

-- ===== بدء وإيقاف الطفو =====
local function startFloat()
	if floatOn or rising or not root or not humanoid then return end

	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	local spawnPos = torso and torso.Position or root.Position

	baseY = root.Position.Y
	markerX, markerY, markerZ = spawnPos.X, baseY, spawnPos.Z
	jumpOffset = 0
	floatOn = true

	humanoid.PlatformStand = true
	disableCollide()
	createMarker()

	local cf = root.CFrame
	root.CFrame = CFrame.new(markerX, markerY - distance, markerZ) * (cf - cf.Position)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	setCameraFree(true)
	setBtn(true)
	refreshStatus()
end

local function stopFloat()
	if not floatOn then return end
	floatOn = false
	rising = true
	jumpOffset = 0
	rootY = root.Position.Y
	targetRootY = math.max(baseY, probeTop(markerX, markerZ) + 3)
	setBtn(false)
	refreshStatus()
end

local function finishRise()
	rising = false
	jumpOffset = 0
	restoreCollide()
	if humanoid then
		humanoid.PlatformStand = false
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	removeMarker()
	setCameraFree(false)
	refreshStatus()
end

-- ===== أحداث الواجهة =====
floatBtn.MouseButton1Click:Connect(function()
	if floatOn then
		stopFloat()
	else
		startFloat()
	end
end)

teleportBtn.MouseButton1Click:Connect(function()
