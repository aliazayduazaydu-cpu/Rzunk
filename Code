local function corner(o, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 10)
	c.Parent = o
end

local function stroke(o, col, t)
	local s = Instance.new("UIStroke")
	s.Color = col or Color3.new(1, 1, 1)
	s.Thickness = t or 1.5
	s.Transparency = 0.25
	s.Parent = o
	return s
end

local function tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function label(parent, text, size, color, font)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextSize = size or 14
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.Font = font or Enum.Font.GothamMedium
	l.Parent = parent
	return l
end

local BLUE, GREEN, RED = Color3.fromRGB(50, 90, 200), Color3.fromRGB(40, 160, 80), Color3.fromRGB(180, 50, 60)

local function makeButton(parent, text, order, color, size)
	local b = Instance.new("TextButton")
	b.Size = size or UDim2.new(1, 0, 0, 38)
	b.LayoutOrder = order or 0
	b.BackgroundColor3 = color or BLUE
	b.Text = text
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 14
	b.AutoButtonColor = false
	b.Parent = parent
	corner(b, 9)
	local base, baseSize = b.BackgroundColor3, b.Size
	b.MouseEnter:Connect(function() tween(b, 0.15, {BackgroundColor3 = base:Lerp(Color3.new(1, 1, 1), 0.2)}) end)
	b.MouseLeave:Connect(function() tween(b, 0.15, {BackgroundColor3 = base}) end)
	b.MouseButton1Down:Connect(function()
		tween(b, 0.08, {Size = UDim2.new(baseSize.X.Scale, baseSize.X.Offset - 6, baseSize.Y.Scale, baseSize.Y.Offset - 4)})
	end)
	b.MouseButton1Up:Connect(function() tween(b, 0.15, {Size = baseSize}, Enum.EasingStyle.Back) end)
	return b
end

local function makeToggle(parent, text, order, onChange)
	local state = false
	local b = makeButton(parent, "", order, RED)
	local function render()
		b.Text = text .. (state and ": شغال ✔" or ": مطفي ✖")
		tween(b, 0.25, {BackgroundColor3 = state and GREEN or RED})
	end
	render()
	b.MouseButton1Click:Connect(function()
		state = not state
		render()
		onChange(state)
	end)
	return b
end

