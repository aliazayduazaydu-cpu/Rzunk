-- ===== توليد الكود =====
local function pathExpr(inst)
	local chain, cur = {}, inst
	while cur and cur ~= game do
		table.insert(chain, 1, cur)
		cur = cur.Parent
	end
	if #chain == 0 or chain[1].Parent ~= game then return nil end

	local s
	if chain[1] == workspace then
		s = "workspace"
	else
		s = "game:GetService(" .. string.format("%q", chain[1].ClassName) .. ")"
	end
	for i = 2, #chain do
		local node, parent = chain[i], chain[i - 1]
		local same = 0
		for _, c in ipairs(parent:GetChildren()) do
			if c.Name == node.Name then same += 1 end
		end
		if same > 1 then
			-- اسم مكرر: نستخدم الترتيب بين الأبناء
			s ..= ":GetChildren()[" .. table.find(parent:GetChildren(), node) .. "]"
		else
			s ..= ":FindFirstChild(" .. string.format("%q", node.Name) .. ")"
		end
	end
	return s
end

local function generate()
	local lines = {}
	for _, e in ipairs(selected) do
		local expr = pathExpr(e.inst)
		if expr then
			table.insert(lines, "\t{group = " .. tostring(e.group) .. ", get = function() return " .. expr .. " end}, -- " .. e.inst.Name:gsub("[\r\n]", " "))
		end
	end
	if #lines == 0 then return nil end
	local targets = table.concat(lines, "\n")
	local a, b = TEMPLATE:find("--TARGETS--", 1, true)
	return TEMPLATE:sub(1, a - 1) .. targets .. TEMPLATE:sub(b + 1), #lines
end

