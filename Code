local function toggleSelect(part)
	if part:IsA("Terrain") then return setStatus("لا يمكن تحديد التضاريس") end
	local inst, group = part, false
	if groupMode then
		local g = part
		for _ = 1, level do
			g = g and g.Parent
			if not g or g == workspace then
				g = nil
				break
			end
		end
		if g then inst, group = g, true end
	end

	for i, e in ipairs(selected) do
		if e.inst == inst then
			if e.hl then e.hl:Destroy() end
			table.remove(selected, i)
			refreshList()
			return setStatus("أُزيل: " .. inst.Name)
		end
	end

	local entry = {inst = inst, group = group, count = group and partCount(inst) or 1}
	pcall(function()
		local hl = Instance.new("Highlight")
		hl.Adornee = inst
		hl.FillColor = group and Color3.fromRGB(80, 170, 255) or Color3.fromRGB(80, 255, 120)
		hl.FillTransparency = 0.55
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = gui
		entry.hl = hl
	end)
	table.insert(selected, entry)
	refreshList()
	setStatus("أُضيف: " .. inst.Name)
end

local function pickTarget(pos)
	local cam = workspace.CurrentCamera
	local ray = cam:ViewportPointToRay(pos.X, pos.Y)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = player.Character and {player.Character} or {}
	local res = workspace:Raycast(ray.Origin, ray.Direction * 2000, rp)
	return res and res.Instance
end

