local function setClickMode(on)
	clickMode = on
	clickBtn.Text = on and "🖱 الاختيار: شغال" or "🖱 اختيار Part"
	clickBtn.BackgroundColor3 = on and Color3.fromRGB(0, 160, 120) or Color3.fromRGB(70, 60, 160)
	updateStatus(on and "اضغط على أي Part" or nil)
end

clickBtn.MouseButton1Click:Connect(function() setClickMode(not clickMode) end)
doneBtn.MouseButton1Click:Connect(function() setClickMode(false) updateStatus("تم ✔") end)

local function overGui(pos)
	local function inside(f)
		if not f.Visible then return false end
		local p, s = f.AbsolutePosition, f.AbsoluteSize
		return pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y
	end
	return inside(main) or inside(toggle)
end

UIS.InputBegan:Connect(function(input)
	if not clickMode then return end
	local t = input.UserInputType
	if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end

	local pos
	if t == Enum.UserInputType.Touch then
		pos = Vector2.new(input.Position.X, input.Position.Y) + GuiService:GetGuiInset()
	else
		pos = UIS:GetMouseLocation()
	end
	if overGui(pos) then return end

	local ray = workspace.CurrentCamera:ViewportPointToRay(pos.X, pos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {lp.Character}
	params.RespectCanCollide = false
	local res = workspace:Raycast(ray.Origin, ray.Direction * 5000, params)
	local part = res and res.Instance
	if part and part:IsA("BasePart") then
		if selected[part] then deselect(part) else select(part) end
		updateStatus()
	end
end)

-- ========== الضغط ==========
local function getRoot()
	local char = lp.Character
	return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart"))
end

local function fireList(list, root)
	for i = 1, #list do
		local p = list[i]
		if p.Parent then
			firetouchinterest(root, p, 0)
			firetouchinterest(root, p, 1)
		end
		if i % BATCH == 0 then RS.Heartbeat:Wait() end
	end
end

local function fireSelected()
	local root = getRoot()
	if not root then return end
	local list = {}
	for p in pairs(selected) do list[#list + 1] = p end
	fireList(list, root)
end

local function fireEverything()
	local root = getRoot()
	if not root then return end
	local list = {}
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("BasePart") and not d:IsDescendantOf(lp.Character) then
			list[#list + 1] = d
		end
	end
	fireList(list, root)
end

local function check()
	if not firetouchinterest then
		updateStatus("executor ما يدعم firetouchinterest")
		return false
	end
	return true
end

fireSelBtn.MouseButton1Click:Connect(function()
	if not check() then return end
	task.spawn(function() pcall(fireSelected) updateStatus("تم ✔") end)
end)

fireAllBtn.MouseButton1Click:Connect(function()
	if not check() then return end
	task.spawn(function() pcall(fireEverything) updateStatus("تم ضغط الكل ✔") end)
end)

autoBtn.MouseButton1Click:Connect(function()
	if not check() then return end
	autoOn = not autoOn
	autoBtn.Text = autoOn and "⏱ أوتو: شغال" or "⏱ أوتو: مغلق"
	autoBtn.BackgroundColor3 = autoOn and Color3.fromRGB(0, 160, 90) or Color3.fromRGB(90, 90, 110)
	if autoOn then
		task.spawn(function()
			while autoOn and gui.Parent do
				if selCount > 0 then pcall(fireSelected) else pcall(fireEverything) end
				local s = tonumber(speedBox.Text) or 0
				if s <= 0 then RS.Heartbeat:Wait() else task.wait(s) end
			end
		end)
	end
end)

