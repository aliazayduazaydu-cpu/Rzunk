-- ========== التحديد ==========
local function updateStatus(extra)
	status.Text = "المحدد: " .. selCount .. (extra and ("  |  " .. extra) or "")
end

local function select(part)
	if selected[part] then return end
	if boxCount < MAX_BOX then
		local sb = Instance.new("SelectionBox")
		sb.Adornee = part
		sb.LineThickness = 0.05
		sb.SurfaceTransparency = 0.5
		sb.Parent = gui
		selected[part] = sb
		boxCount += 1
	else
		selected[part] = true
	end
	selCount += 1
end

local function deselect(part)
	local v = selected[part]
	if v then
		if v ~= true then v:Destroy() boxCount -= 1 end
		selected[part] = nil
		selCount -= 1
	end
end

clearBtn.MouseButton1Click:Connect(function()
	for p in pairs(selected) do deselect(p) end
	selCount, boxCount = 0, 0
	updateStatus()
end)

