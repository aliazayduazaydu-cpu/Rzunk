local Lighting = game:GetService("Lighting")
local BrightEnabled = false

Tab:Toggle({
    Title = "Light All",
    Desc = "تشغيل أو إيقاف الإضاءة",
    Default = false,

    Callback = function(Value)
        BrightEnabled = Value

        if Value then
            task.spawn(function()
                while BrightEnabled do
                    Lighting.Brightness = 2
                    Lighting.ClockTime = 14
                    Lighting.FogEnd = 100000
                    Lighting.GlobalShadows = false
                    Lighting.Ambient = Color3.fromRGB(180, 180, 180)

                    task.wait(0.5)
                end
            end)
        end
    end,
})
local Tab = Window:Tab({
    Title = "esp اشياء",
    Icon = "", -- optional
    Locked = false,
})
Tab:Toggle({
    Title = "ESP فار",
    Default = false,
    Callback = function(Value)
        local part = workspace:FindFirstChild("Mouse")
        if not part then
            warn("ما لقيت workspace.Mouse")
            return
        end

        local old = part:FindFirstChild("MouseESP")

        if Value then
            if not old then
                local esp = Instance.new("Highlight")
                esp.Name = "MouseESP"
                esp.Adornee = part
                esp.FillColor = Color3.fromRGB(255, 0, 0)
                esp.OutlineColor = Color3.fromRGB(255, 0, 0)
                esp.FillTransparency = 0.5
                esp.OutlineTransparency = 0
                esp.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                esp.Parent = part
            end
        elseif old then
            old:Destroy()
        end
    end
})
