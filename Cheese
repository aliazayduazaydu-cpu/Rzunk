local ActiveESP = {}

local function SetToolESP(name, enabled)
    if ActiveESP[name] then
        ActiveESP[name]:Destroy()
        ActiveESP[name] = nil
    end

    if not enabled then
        return
    end

    local getter = ToolObjects[name]
    local object = getter and getter()

    if not object then
        warn("لم يتم العثور على الأداة: " .. name)
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_" .. name
    highlight.Adornee = object
    highlight.FillColor = Color3.fromRGB(0, 255, 0)
    highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
    highlight.FillTransparency = 1
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = ESPFolder

    ActiveESP[name] = highlight
end

Tab:Toggle({
    Title = "ESP كل الأدوات",
    Default = false,
    Callback = function(value)
        for name in pairs(ToolObjects) do
            SetToolESP(name, value)
        end
    end
})

for name in pairs(ToolObjects) do
    Tab:Toggle({
        Title = "ESP " .. name,
        Default = false,
        Callback = function(value)
            SetToolESP(name, value)
        end
    })
end

local Folder = workspace:WaitForChild("FindCheese")
local ESPs = {}

local function SetESP(index, enabled)
    local key = tostring(index)

    if ESPs[key] then
        ESPs[key]:Destroy()
        ESPs[key] = nil
    end

    if not enabled then
        return
    end

    local children = Folder:GetChildren()
    local item = children[index]
    local cheese = item and item:FindFirstChild("Cheese")

    if not cheese then
        warn("لم يتم العثور على Cheese رقم " .. index)
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "CheeseESP_" .. key
    highlight.Adornee = cheese
    highlight.FillColor = Color3.fromRGB(0, 100, 255)
    highlight.OutlineColor = Color3.fromRGB(0, 100, 255)
    highlight.FillTransparency = 1
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = cheese

    ESPs[key] = highlight
end

