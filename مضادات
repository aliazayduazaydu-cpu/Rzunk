-- ================== مضاد الفويد ==================
local VoidEnabled = false
local VoidDistance = 550     -- قوة/ارتفاع الصعود (ثابت)
local TriggerDepth = 400     -- كم ستد تنزل تحت آخر أرضية قبل التفعيل (ثابت)
local VoidConn
local LastGroundY = nil
local LastBoost = 0

local function StopVoid()
    if VoidConn then
        VoidConn:Disconnect()
        VoidConn = nil
    end
    LastGroundY = nil
end

local function StartVoid()
    StopVoid()
    VoidConn = RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then return end

        -- تسجيل آخر ارتفاع وقفت عليه فعلاً
        if hum.FloorMaterial ~= Enum.Material.Air then
            LastGroundY = root.Position.Y
            return
        end

        if not LastGroundY then return end

        local vel = root.AssemblyLinearVelocity

        -- يتفعّل فقط إذا نزلت تحت آخر أرضية بـ TriggerDepth وأنت تسقط
        if root.Position.Y > LastGroundY - TriggerDepth or vel.Y >= 0 then return end

        -- إذا فيه أرض قريبة تحتك لا يتدخل
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { char }
        local hit = Workspace:Raycast(root.Position, Vector3.new(0, -math.max(300, TriggerDepth), 0), params)
        if hit then return end

        -- مانع تكرار سريع
        if os.clock() - LastBoost < 0.5 then return end
        LastBoost = os.clock()

        local v = math.sqrt(2 * Workspace.Gravity * VoidDistance)
        root.AssemblyLinearVelocity = Vector3.new(vel.X, v, vel.Z)
    end)
end

ProtectTab:Toggle({
    Title = "مضاد الفويد",
    Desc = "يمنع موت في فويد",
    Default = false,
    Callback = function(state)
        VoidEnabled = state
        if state then
            StartVoid()
        else
            StopVoid()
        end
    end
})

-- ================== نو كليب للاعبين الآخرين ==================
local NoclipOthersEnabled = false
local NoclipOthersGen = 0          -- يمنع تشغيل أكثر من حلقة في نفس الوقت
local OthersOriginalCollide = {}   -- [BasePart] = CanCollide الأصلي

local function ApplyNoclipToOthers()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            for _, d in ipairs(plr.Character:GetDescendants()) do
                if d:IsA("BasePart") then
                    if OthersOriginalCollide[d] == nil then
                        OthersOriginalCollide[d] = d.CanCollide
                    end
                    d.CanCollide = false
                end
            end
        end
    end
end

local function RestoreOthers()
    for part, original in pairs(OthersOriginalCollide) do
        if part.Parent then
            part.CanCollide = original
        end
    end
    table.clear(OthersOriginalCollide)
end

local function StartNoclipOthers()
    NoclipOthersGen += 1
    local gen = NoclipOthersGen
    task.spawn(function()
        while NoclipOthersEnabled and gen == NoclipOthersGen do
            ApplyNoclipToOthers()
            task.wait(0.3)
        end
        if gen == NoclipOthersGen then
            RestoreOthers()
        end
    end)
end

ProtectTab:Toggle({
    Title = "مضاد فنق",
    Desc = "ما يقدر يطيروك في جو",
    Default = false,
    Callback = function(state)
        NoclipOthersEnabled = state
        if state then
            StartNoclipOthers()
        else
            NoclipOthersGen += 1
            RestoreOthers()
        end
    end
})


-- ================== مضاد الجلوس ==================
local AntiSitEnabled = false
local AntiSitConn

local function StopAntiSit()
    if AntiSitConn then
        AntiSitConn:Disconnect()
        AntiSitConn = nil
    end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
    end
end

local function StartAntiSit()
    StopAntiSit()
    AntiSitConn = RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        if hum.Sit then
            hum.Sit = false
            hum.Jump = true
        end
    end)
end

ProtectTab:Toggle({
    Title = "مضاد الجلوس",
    Desc = "يمنع فنق جلوس",
    Default = false,
    Callback = function(state)
        AntiSitEnabled = state
        if state then
            StartAntiSit()
        else
            StopAntiSit()
        end
    end
})
