local function makeButton(parent, text, order, color)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 40)
	b.LayoutOrder = order or 0
	b.BackgroundColor3 = color or Color3.fromRGB(50, 90, 200)
	b.BackgroundTransparency = 0.15
	b.Text = text
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 15
	b.AutoButtonColor = false
	b.ZIndex = 4
	b.Parent = parent
	corner(b, 10)
	stroke(b, Color3.new(1, 1, 1), 1)
	local base = color or Color3.fromRGB(50, 90, 200)
	b.MouseEnter:Connect(function() tween(b, 0.15, {BackgroundColor3 = base:Lerp(Color3.new(1, 1, 1), 0.2)}) end)
	b.MouseLeave:Connect(function() tween(b, 0.15, {BackgroundColor3 = base}) end)
	b.MouseButton1Down:Connect(function() tween(b, 0.08, {Size = UDim2.new(1, -8, 0, 36)}) end)
	b.MouseButton1Up:Connect(function() tween(b, 0.15, {Size = UDim2.new(1, 0, 0, 40)}, Enum.EasingStyle.Back) end)
	return b
end

local GREEN, RED = Color3.fromRGB(40, 160, 80), Color3.fromRGB(180, 50, 60)

local function makeToggle(parent, text, default, order, onChange)
	local b = makeButton(parent, "", order, default and GREEN or RED)
	local state = default
	local function render()
		b.Text = text .. (state and ": شغال ✔" or ": مطفي ✖")
		tween(b, 0.25, {BackgroundColor3 = state and GREEN or RED})
	end
	render()
	b.MouseButton1Click:Connect(function()
		state = not state
		render()
		onChange(state)
	end)
	return b
end

local function makeSlider(parent, text, min, max, default, step, order, onChange)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, 0, 0, 50)
	holder.BackgroundTransparency = 1
	holder.LayoutOrder = order
	holder.Parent = parent

	local lbl = label(holder, "", 14)
	lbl.Size = UDim2.new(1, 0, 0, 20)
	lbl.TextXAlignment = Enum.TextXAlignment.Left

	local hit = Instance.new("Frame")
	hit.Position = UDim2.new(0, 0, 0, 22)
	hit.Size = UDim2.new(1, 0, 0, 26)
	hit.BackgroundTransparency = 1
	hit.Parent = holder

	local track = Instance.new("Frame")
	track.AnchorPoint = Vector2.new(0, 0.5)
	track.Position = UDim2.new(0, 0, 0.5, 0)
	track.Size = UDim2.new(1, 0, 0, 8)
	track.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
	track.ZIndex = 4
	track.Parent = hit
	corner(track, 4)

	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = Color3.fromRGB(120, 170, 255)
	fill.ZIndex = 5
	fill.Parent = track
	corner(fill, 4)

	local knob = Instance.new("Frame")
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Size = UDim2.new(0, 18, 0, 18)
	knob.BackgroundColor3 = Color3.new(1, 1, 1)
	knob.ZIndex = 6
	knob.Parent = track
	corner(knob, 9)

	local function render(v)
		local a = (v - min) / (max - min)
		fill.Size = UDim2.new(a, 0, 1, 0)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		lbl.Text = text .. ": " .. tostring(math.floor(v * 100 + 0.5) / 100)
	end
	render(default)

	local dragging = false
	local function setFromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local v = min + a * (max - min)
		v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
		render(v)
		onChange(v)
	end
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(i.Position.X)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			setFromX(i.Position.X)
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

