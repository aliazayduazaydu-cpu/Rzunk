	while gui.Parent do
		if cfg.autoOn and os.clock() >= nextAuto then
			local n = fireAllRemotes()
			setStatus("اوتو: " .. n .. " Remote")
			nextAuto = os.clock() + cfg.delay
		end
		task.wait(0.1)
	end
end)

