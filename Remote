local isOpen = false
local function setOpen(state)
	isOpen = state
	if state then
		menu.Visible = true
		toggleBtn.Text = "✖ إغلاق"
		tween(menu, 0.4, {Size = OPEN_SIZE}, Enum.EasingStyle.Back)
	else
		toggleBtn.Text = "☰ القائمة"
		local t = tween(menu, 0.3, {Size = CLOSED_SIZE}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		t.Completed:Connect(function()
			if not isOpen then menu.Visible = false end
		end)
	end
end
toggleBtn.MouseButton1Click:Connect(function() setOpen(not isOpen) end)

