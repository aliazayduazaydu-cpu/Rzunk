-- ===== الوظائف (كلها بدفعات بدون لاق) =====
local function getRoot()
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function fireOne(v)
	if not v.Parent then return end
	if v:IsA("RemoteEvent") then
		pcall(v.FireServer, v)
	else
		task.spawn(pcall, v.InvokeServer, v) -- InvokeServer يوقف، فنشغله بخيط منفصل
	end
end

local busy = false
local function fireAllRemotes()
	if busy then return 0 end
	busy = true
	local n = 0
	local snapshot = table.clone(remotes)
	for _, v in ipairs(snapshot) do
		if not gui.Parent then break end
		if v.Parent and not disabled[v] then
			fireOne(v)
			n += 1
			if n % cfg.batch == 0 then task.wait(0.05) end
		end
	end
	busy = false
	return n
end

local function clickAll()
	local n, i = 0, 0
	for _, v in ipairs(workspace:GetDescendants()) do
		i += 1
		if v:IsA("ClickDetector") and fireclickdetector then
			pcall(fireclickdetector, v)
			n += 1
		elseif v:IsA("ProximityPrompt") and fireproximityprompt then
			pcall(fireproximityprompt, v)
			n += 1
		end
		if i % 150 == 0 then task.wait() end
	end
	setStatus("تم ضغط " .. n)
end

local function touchAll()
	local root = getRoot()
	if not root then return setStatus("لا توجد شخصية") end
	if not firetouchinterest then return setStatus("المشغل لا يدعم firetouchinterest") end
	local n, i = 0, 0
	for _, v in ipairs(workspace:GetDescendants()) do
		i += 1
		if v:IsA("BasePart") and not v:IsDescendantOf(player.Character) then
			if not cfg.touchOnlyInterest or v:FindFirstChildWhichIsA("TouchTransmitter") then
				pcall(function()
					firetouchinterest(root, v, 0)
					firetouchinterest(root, v, 1)
				end)
				n += 1
			end
		end
		if i % 100 == 0 then task.wait() end
	end
	setStatus("تم لمس " .. n .. " Part")
end

