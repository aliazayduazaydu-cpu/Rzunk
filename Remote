local MAX_ROWS = 40
local function refreshList()
	for _, c in ipairs(scroll:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end
	local q = search.Text:lower()
	local shown = 0
	for _, v in ipairs(remotes) do
		if v.Parent and (q == "" or v.Name:lower():find(q, 1, true)) then
			shown += 1
			if shown > MAX_ROWS then break end
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, -4, 0, 30)
			row.BackgroundColor3 = Color3.fromRGB(35, 35, 55)
			row.BackgroundTransparency = 0.2
			row.ZIndex = 4
			row.Parent = scroll
			corner(row, 6)

			local nm = label(row, (v:IsA("RemoteEvent") and "📨 " or "📞 ") .. v.Name, 13)
			nm.Size = UDim2.new(1, -70, 1, 0)
			nm.Position = UDim2.new(0, 6, 0, 0)
			nm.TextXAlignment = Enum.TextXAlignment.Left
			nm.TextTruncate = Enum.TextTruncate.AtEnd

			local fb = makeButton(row, "▶", 0, Color3.fromRGB(50, 90, 200))
			fb.Size = UDim2.new(0, 28, 0, 24)
			fb.Position = UDim2.new(1, -32, 0.5, -12)
			fb.TextSize = 13
			fb.MouseButton1Up:Connect(function() fb.Size = UDim2.new(0, 28, 0, 24) end)
			fb.MouseButton1Down:Connect(function() end)
			fb.MouseButton1Click:Connect(function()
				fireOne(v)
				setStatus("شغّلت " .. v.Name)
			end)

			local tb = makeButton(row, disabled[v] and "✖" or "✔", 0, disabled[v] and RED or GREEN)
			tb.Size = UDim2.new(0, 28, 0, 24)
			tb.Position = UDim2.new(1, -64, 0.5, -12)
			tb.TextSize = 13
			tb.MouseButton1Up:Connect(function() tb.Size = UDim2.new(0, 28, 0, 24) end)
			tb.MouseButton1Click:Connect(function()
				disabled[v] = not disabled[v] or nil
				tb.Text = disabled[v] and "✖" or "✔"
				tween(tb, 0.2, {BackgroundColor3 = disabled[v] and RED or GREEN})
			end)
		end
	end
	setStatus("Remotes: " .. #remotes .. " | معروض: " .. math.min(shown, MAX_ROWS))
end

