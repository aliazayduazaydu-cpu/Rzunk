local NoclipOthersEnabled = false

local NoclipOthersGen = 0
local OthersOriginalCollide = {}

local function ApplyNoclipToOthers()
    for _, player in ipairs(Players:GetPlayers()) do

        if player ~= LocalPlayer and player.Character then

            for _, part in ipairs(player.Character:GetDescendants()) do

                if part:IsA("BasePart") then

                    if OthersOriginalCollide[part] == nil then
                        OthersOriginalCollide[part] = part.CanCollide
                    end

                    part.CanCollide = false
                end
            end
        end
    end
end

local function RestoreOthers()
    for part, original in pairs(OthersOriginalCollide) do

        if part and part.Parent then
            part.CanCollide = original
        end
    end

    table.clear(OthersOriginalCollide)
end

local function StartNoclipOthers()
    NoclipOthersGen += 1

    local gen = NoclipOthersGen

    task.spawn(function()

        while NoclipOthersEnabled
            and gen == NoclipOthersGen do

            ApplyNoclipToOthers()

            task.wait(0.3)
        end

        if gen == NoclipOthersGen then
            RestoreOthers()
        end
    end)
end

