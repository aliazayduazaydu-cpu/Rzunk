-- ================== Heartbeat: سرعة + قفز + جاذبية صفر ==================
RunService.Heartbeat:Connect(function(dt)
    local hum = getHum()
    if hum then
        if State.SpeedOn then
            hum.WalkSpeed = State.Speed
        end
        if State.JumpOn then
            hum.UseJumpPower = true
            hum.JumpPower = State.JumpPower
        end
    end

    if State.ZeroG then
        local root = getRoot()
        local cam = Workspace.CurrentCamera
        if root and cam then
            local target = Vector3.zero

            if touching and touchPos then
                local ray = cam:ViewportPointToRay(touchPos.X, touchPos.Y)

                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = {getChar()}

                local hit = Workspace:Raycast(ray.Origin, ray.Direction * 500, params)
                local dest = hit and hit.Position or (ray.Origin + ray.Direction * 200)

                local diff = dest - root.Position
                if diff.Magnitude > 4 then
                    target = diff.Unit * State.ZeroGSpeed
                end
            end

            ZeroGVel = ZeroGVel:Lerp(target, math.clamp(dt * 6, 0, 1))
            root.AssemblyLinearVelocity = ZeroGVel
        end
    end
end)

