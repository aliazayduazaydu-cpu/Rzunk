local function setZeroG(on)
    State.ZeroG = on

    local root = getRoot()
    local hum = getHum()

    if on and root and hum then

        hum.PlatformStand = true

        ZeroGAtt = Instance.new("Attachment")
        ZeroGAtt.Parent = root

        ZeroGForce = Instance.new("VectorForce")
        ZeroGForce.Attachment0 = ZeroGAtt
        ZeroGForce.RelativeTo = Enum.ActuatorRelativeTo.World

        ZeroGForce.Force = Vector3.new(
            0,
            Workspace.Gravity * root.AssemblyMass,
            0
        )

        ZeroGForce.Parent = root

    else

        if ZeroGForce then
            ZeroGForce:Destroy()
            ZeroGForce = nil
        end

        if ZeroGAtt then
            ZeroGAtt:Destroy()
            ZeroGAtt = nil
        end

        ZeroGVel = Vector3.zero
        touching = false

        if hum then
            hum.PlatformStand = false
        end
    end
end

