-- ================== دوال مساعدة ==================
local function getChar()
    return LocalPlayer.Character
end

local function getHum()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local c = getChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getPlayerList()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p.Name)
        end
    end
    return list
end

local function getSelected()
    return State.SelectedPlayer and Players:FindFirstChild(State.SelectedPlayer)
end

-- ================== ESP (توهج أحمر + اسم) ==================
local function clearESP(player)
    local objs = ESPObjects[player]
    if objs then
        for _, o in ipairs(objs) do
            if o then o:Destroy() end
        end
    end
    ESPObjects[player] = nil
end

local function shouldESP(player)
    if State.ESPAll then return true end
    return State.ESPSelected and State.SelectedPlayer == player.Name
end

local function applyESP(player)
    clearESP(player)
    if player == LocalPlayer or not shouldESP(player) then return end
    local char = player.Character
    if not char then return end

    local objs = {}

    local hl = Instance.new("Highlight")
    hl.FillColor = RED
    hl.OutlineColor = RED
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = char
    hl.Parent = char
    table.insert(objs, hl)

    local head = char:FindFirstChild("Head")
    if head then
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.fromOffset(140, 30)
        bb.StudsOffset = Vector3.new(0, 2.5, 0)
        bb.AlwaysOnTop = true
        bb.Adornee = head
        bb.Parent = head

        local tl = Instance.new("TextLabel")
        tl.Size = UDim2.fromScale(1, 1)
        tl.BackgroundTransparency = 1
        tl.TextColor3 = RED
        tl.TextStrokeTransparency = 0
        tl.Font = Enum.Font.GothamBold
        tl.TextScaled = true
        tl.Text = player.Name
        tl.Parent = bb
        table.insert(objs, bb)
    end

    ESPObjects[player] = objs
end

local function refreshAllESP()
    for _, p in ipairs(Players:GetPlayers()) do
        applyESP(p)
    end
end

local function hookPlayer(p)
    p.CharacterAdded:Connect(function()
        task.wait(0.5)
        applyESP(p)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    hookPlayer(p)
end
Players.PlayerAdded:Connect(hookPlayer)
Players.PlayerRemoving:Connect(function(p)
    clearESP(p)
end)

-- ================== View ==================
local function setView(on)
    local cam = Workspace.CurrentCamera
    local target = on and getSelected()
    local hum = target and target.Character and target.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        cam.CameraSubject = hum
    else
        local myHum = getHum()
        if myHum then cam.CameraSubject = myHum end
    end
end

-- ================== Teleport ==================
local function teleportToSelected()
    local target = getSelected()
    local myRoot = getRoot()
    local troot = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if myRoot and troot then
        myRoot.CFrame = troot.CFrame + Vector3.new(0, 3, 0)
    end
end

-- ================== Zero Gravity (طيران نحو نقطة تحددها الكاميرا) ==================
UserInputService.InputBegan:Connect(function(input, gp)
    if not State.ZeroG then return end
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        touchInput = input
        touchPos = input.Position
        touching = true
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == touchInput then
        touchPos = input.Position
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == touchInput then
        touchInput = nil
        touchPos = nil
        touching = false
    end
end)

local function setZeroG(on)
    State.ZeroG = on
    local root, hum = getRoot(), getHum()

    if on and root and hum then
        hum.PlatformStand = true

        ZeroGAtt = Instance.new("Attachment")
        ZeroGAtt.Parent = root

        ZeroGForce = Instance.new("VectorForce")
        ZeroGForce.Attachment0 = ZeroGAtt
        ZeroGForce.RelativeTo = Enum.ActuatorRelativeTo.World
        ZeroGForce.Force = Vector3.new(0, Workspace.Gravity * root.AssemblyMass, 0)
        ZeroGForce.Parent = root
    else
        if ZeroGForce then ZeroGForce:Destroy() ZeroGForce = nil end
        if ZeroGAtt then ZeroGAtt:Destroy() ZeroGAtt = nil end
        ZeroGVel = Vector3.zero
        touching = false
        if hum then hum.PlatformStand = false end
    end
end

LocalPlayer.CharacterAdded:Connect(function()
    if State.ZeroG then
        task.wait(1)
        setZeroG(true)
    end
end)

