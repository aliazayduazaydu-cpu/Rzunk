--==================================================
-- ESP SYSTEM
--==================================================

local ESPObjects = {}

local function clearESP(player)
    local objects = ESPObjects[player]

    if objects then
        for _, object in ipairs(objects) do
            if object and object.Parent then
                object:Destroy()
            end
        end
    end

    ESPObjects[player] = nil
end

local function shouldESP(player)
    if State.ESPAll then
        return true
    end

    if State.ESPSelected
        and State.SelectedPlayer == player.Name then
        return true
    end

    return false
end

local function applyESP(player)
    clearESP(player)

    if player == LocalPlayer then
        return
    end

    if not shouldESP(player) then
        return
    end

    local char = player.Character
    if not char then return end

    local objects = {}

    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = char
    highlight.Parent = char

    table.insert(objects, highlight)

    local head = char:FindFirstChild("Head")

    if head then
        local billboard = Instance.new("BillboardGui")

        billboard.Size = UDim2.fromOffset(140, 30)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Adornee = head
        billboard.Parent = head

        local label = Instance.new("TextLabel")

        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(255, 0, 0)
        label.TextStrokeTransparency = 0
        label.Font = Enum.Font.GothamBold
        label.TextScaled = true
        label.Text = player.Name
        label.Parent = billboard

        table.insert(objects, billboard)
    end

    ESPObjects[player] = objects
end

local function refreshAllESP()
    for _, player in ipairs(Players:GetPlayers()) do
        applyESP(player)
    end
end

local function hookPlayer(player)
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        applyESP(player)
    end)
end

for _, player in ipairs(Players:GetPlayers()) do
