--==================================================
-- FLOAT SYSTEM TAB
--==================================================

local FloatTab = Window:Tab({
    Title = "قائمة اختفاء",
    Icon = "cloud",
    Locked = false,
})


floatToggle = FloatTab:Toggle({
    Title = "اختفء",
    Desc = "تشغيل وإيقاف اختفاء",
    Default = false,

    Callback = function(state)
        if updatingUI then return end

        if state then
            startFloat()
        else
            stopFloat()
        end
    end
})

-- المسافة
FloatTab:Input({
    Title = "مسافه عمق نزول اختفاء",
    Desc = "المسافة بين اللاعب والمربع (1-300)",
    Placeholder = "30",

    Callback = function(value)
        local number = tonumber(value)
        if not number then return end

        distance = math.clamp(
            math.floor(math.abs(number)),
            1,
            MAX_DISTANCE
        )

        refreshFloatStatus()
    end
})

-- السرعة
FloatTab:Input({
    Title = "سرعه مشي مربع",
    Desc = "سرعة حركة المربع (1-500)",
    Placeholder = "16",

    Callback = function(value)
        local number = tonumber(value)
        if not number then return end

        speed = math.clamp(
            math.floor(math.abs(number)),
            1,
            MAX_SPEED
        )

        refreshFloatStatus()
    end
})



teleportToggle = FloatTab:Toggle({
    Title = "أداة الانتقال لمربع",
    Desc = "فعّلها ثم اضغط على المكان لنقل المربع إليه",
    Default = false,

    Callback = function(state)
        if updatingUI then return end

        teleportOn = state
    end
})

--==================================================
-- CHARACTER
--==================================================

FloatPlayer.CharacterAdded:Connect(onFloatCharacterAdded)

if FloatPlayer.Character then
    task.spawn(
        onFloatCharacterAdded,
        FloatPlayer.Character
    )
end
