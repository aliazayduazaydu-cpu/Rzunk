local function onFloatCharacterAdded(char)
    character = char

    humanoid = char:WaitForChild("Humanoid")
    root = char:WaitForChild("HumanoidRootPart")

    savedCollide = {}

    floatOn = false
    rising = false
    jumpOffset = 0
    teleportOn = false

    removeMarker()
    setFloatCamera(false)
    setFloatButton(false)
    setTeleportButton(false)
    refreshFloatStatus()
end
