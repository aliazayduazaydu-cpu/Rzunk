-- ====== Style: أزرار سوداء + حواف قوس قزح + تأثيرات ======
local strokes = {}

local function addCorner(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = obj
end

local function addStroke(obj, thickness)
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Thickness = thickness or 2.5
	s.Color = Color3.new(1, 0, 0)
	s.Parent = obj
	table.insert(strokes, s)
	return s
end

local function playClick()
	local s = Instance.new("Sound")
	s.SoundId = CLICK_SOUND
	s.Volume = 1
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 5)
end

local function styleButton(btn)
	btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.ScaleType = Enum.ScaleType.Fit
	addCorner(btn, 10)
	addStroke(btn, 2.5)

	local scale = Instance.new("UIScale")
	scale.Parent = btn
	local info = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, info, {BackgroundColor3 = Color3.fromRGB(40, 40, 40)}):Play()
		TweenService:Create(scale, info, {Scale = 1.07}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, info, {BackgroundColor3 = Color3.fromRGB(0, 0, 0)}):Play()
		TweenService:Create(scale, info, {Scale = 1}):Play()
	end)
	btn.MouseButton1Down:Connect(function()
		playClick()
		TweenService:Create(scale, TweenInfo.new(0.08), {Scale = 0.9}):Play()
	end)
	btn.MouseButton1Up:Connect(function()
		TweenService:Create(scale, info, {Scale = 1.07}):Play()
	end)
end

for _, b in ipairs({up, down, onof, plus, mine, closebutton, mini, mini2}) do
	styleButton(b)
end

