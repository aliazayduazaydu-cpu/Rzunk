local selectedName = nil

local function copyToolsFrom(targetPlayer)
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack or not targetPlayer then return 0 end

    local count = 0
    local sources = {}

    if targetPlayer:FindFirstChildOfClass("Backpack") then
        table.insert(sources, targetPlayer:FindFirstChildOfClass("Backpack"))
    end

    if targetPlayer.Character then
        table.insert(sources, targetPlayer.Character)
    end

    for _, source in ipairs(sources) do
        for _, item in ipairs(source:GetChildren()) do
            if item:IsA("Tool") then
                item:Clone().Parent = backpack
                count = count + 1
            end
        end
    end

    return count
end

local function getPlayerNames()
    local names = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(names, player.Name)
        end
    end

    return names
end

