-- FLOAT SYSTEM - ALI
--==================================================

local FloatPlayer = Players.LocalPlayer
local FloatRunService = RunService

local MAX_DISTANCE = 300
local MAX_SPEED = 500

local distance = 30
local speed = 16

local JUMP_HEIGHT = 4
local JUMP_RECOVER = 12
local FALL_SPEED = 60
local ASCEND_SPEED = 4000

local MARKER_SIZE = Vector3.new(8, 0.5, 8)
local STEP_HEIGHT = 15
local COLUMN_SIZE = Vector3.new(8, 40, 8)

local floatOn = false
local rising = false
local teleportOn = false

local baseY = 0
local markerX, markerY, markerZ = 0, 0, 0
local rootY, targetRootY = 0, 0
local jumpOffset = 0

local character, humanoid, root
local marker = nil
local savedCollide = {}

local floatToggle
local teleportToggle
local statusParagraph
local updatingUI = false

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Exclude

--==================================================
-- واجهة الطفو
--==================================================

local function setFloatButton(on)
    if not floatToggle then return end

    updatingUI = true
    floatToggle:Set(on)
    updatingUI = false
end

local function setTeleportButton(on)
    if not teleportToggle then return end

    updatingUI = true
    teleportToggle:Set(on)
    updatingUI = false
end

local function refreshFloatStatus()
    if not statusParagraph then return end

    if floatOn then
        statusParagraph:SetDesc(
            "طافي | المسافة: " .. distance ..
            " | السرعة: " .. speed
        )
    elseif rising then
        statusParagraph:SetDesc("جاري الصعود...")
    else
        statusParagraph:SetDesc("الحالة: على السطح")
    end
end

--==================================================
-- المربع
--==================================================

local function createMarker()
    if marker then marker:Destroy() end

    marker = Instance.new("Part")
    marker.Name = "AliFloatMarker"
    marker.Anchored = true
    marker.CanCollide = false
    marker.CanQuery = false
    marker.CanTouch = false
    marker.Material = Enum.Material.Neon
    marker.Color = Color3.fromRGB(255, 0, 0)
    marker.Transparency = 0
    marker.Size = MARKER_SIZE
    marker.CFrame = CFrame.new(markerX, markerY, markerZ)
    marker.Parent = workspace

    rayParams.FilterDescendantsInstances = {character, marker}
    overlapParams.FilterDescendantsInstances = {character, marker}
end

local function removeMarker()
    if marker then
        marker:Destroy()
        marker = nil
    end
end

--==================================================
-- التصادم
--==================================================

local function disableFloatCollide()
    if not character then return end

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            if savedCollide[part] == nil then
                savedCollide[part] = part.CanCollide
            end

            part.CanCollide = false
        end
    end
end

local function restoreFloatCollide()
    for part, original in pairs(savedCollide) do
        if part and part.Parent then
            part.CanCollide = original
        end
    end

    savedCollide = {}
end

local function setFloatCamera(on)
    local cam = workspace.CurrentCamera
    if not cam then return end

    cam.CameraType = Enum.CameraType.Custom

    if on and marker then
        cam.CameraSubject = marker
    elseif humanoid then
        cam.CameraSubject = humanoid
    end
end

--==================================================
-- اكتشاف الأرض
--==================================================

local function probeTop(x, z)
    local result = workspace:Blockcast(
        CFrame.new(x, markerY + 1, z),
        MARKER_SIZE,
        Vector3.new(0, -600, 0),
        rayParams
    )

    if result then
        return result.Position.Y
    end

    return -math.huge
end

local function blockingTop(x, z)
    local parts = workspace:GetPartBoundsInBox(
        CFrame.new(x, markerY + 20.5, z),
        COLUMN_SIZE,
        overlapParams
    )

    local highest = nil

    for _, p in ipairs(parts) do
        if p.CanCollide then
            local top = p.Position.Y + p.Size.Y / 2

            if not highest or top > highest then
                highest = top
            end
        end
    end

    return highest
end

--==================================================
-- حركة المربع
--==================================================

local function tryMove(delta)
    local nx = markerX + delta.X
    local nz = markerZ + delta.Z

    local top = blockingTop(nx, nz)

    if not top or top <= markerY + 0.5 then
        markerX, markerZ = nx, nz
        return
    end

    if top - markerY <= STEP_HEIGHT then
        markerX, markerZ = nx, nz
        markerY = top + MARKER_SIZE.Y / 2
    end
end

--==================================================
-- الانتقال إلى المكان المحدد
--==================================================

local function floatTeleportTo(screenX, screenY)
    if not floatOn or not marker then return end

    local cam = workspace.CurrentCamera
    local ray = cam:ViewportPointToRay(screenX, screenY)

    local hit = workspace:Raycast(
        ray.Origin,
        ray.Direction * 2000,
        rayParams
    )

    if not hit then return end

    markerX = hit.Position.X
    markerZ = hit.Position.Z
    markerY = hit.Position.Y + MARKER_SIZE.Y / 2

    jumpOffset = 0
end

--==================================================
-- تشغيل الطفو
--==================================================

local function startFloat()
    if floatOn or rising or not root or not humanoid then
        return
    end

    local torso =
        character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")

    local spawnPos = torso and torso.Position or root.Position

    baseY = root.Position.Y

    markerX, markerY, markerZ =
        spawnPos.X, baseY, spawnPos.Z

    jumpOffset = 0
    floatOn = true

    humanoid.PlatformStand = true

    disableFloatCollide()
    createMarker()

    local cf = root.CFrame

    root.CFrame =
        CFrame.new(markerX, markerY - distance, markerZ)
        * (cf - cf.Position)

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    setFloatCamera(true)
    setFloatButton(true)
    refreshFloatStatus()
end

--==================================================
-- إيقاف الطفو
--==================================================

local function stopFloat()
    if not floatOn then return end

    floatOn = false
    rising = true
    jumpOffset = 0

    rootY = root.Position.Y

    targetRootY = math.max(
        baseY,
        probeTop(markerX, markerZ) + 3
    )

    setFloatButton(false)
    refreshFloatStatus()
end

--==================================================
-- إنهاء الصعود
--==================================================

local function finishRise()
    rising = false
    jumpOffset = 0

    restoreFloatCollide()

    if humanoid then
        humanoid.PlatformStand = false
        humanoid:ChangeState(
            Enum.HumanoidStateType.GettingUp
        )
    end

    removeMarker()
    setFloatCamera(false)
    refreshFloatStatus()
end

--==================================================
-- لمس الشاشة للانتقال
--==================================================

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not teleportOn then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        floatTeleportTo(
            input.Position.X,
            input.Position.Y
        )
    end
end)

