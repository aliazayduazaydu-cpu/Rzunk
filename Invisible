    Description = "تعطيل التصادم محلياً للشخصيات الأخرى",
    Default = false,

    Callback = function(state)
        NoclipOthersEnabled = state

        if state then
            StartNoclipOthers()
        else
            NoclipOthersGen = NoclipOthersGen + 1
            RestoreOthers()
        end
    end
})

