--==================================================
-- MARKER
--==================================================

local function createMarker()
    if marker then
        marker:Destroy()
    end

    marker = Instance.new("Part")
    marker.Name = "AliFloatMarker"
    marker.Anchored = true
    marker.CanCollide = false
    marker.CanQuery = false
    marker.CanTouch = false
    marker.Material = Enum.Material.Neon
    marker.Color = Color3.fromRGB(255, 0, 0)
    marker.Transparency = 0
    marker.Size = MARKER_SIZE
    marker.CFrame = CFrame.new(markerX, markerY, markerZ)
    marker.Parent = Workspace

    rayParams.FilterDescendantsInstances = {
        character,
        marker
    }

    overlapParams.FilterDescendantsInstances = {
        character,
        marker
    }
end

local function removeMarker()
    if marker then
        marker:Destroy()
        marker = nil
    end
end

--==================================================
-- COLLISION
--==================================================

local function disableFloatCollide()
    if not character then return end

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then

            if savedCollide[part] == nil then
                savedCollide[part] = part.CanCollide
            end

            part.CanCollide = false
        end
    end
end

local function restoreFloatCollide()
    for part, original in pairs(savedCollide) do
        if part and part.Parent then
            part.CanCollide = original
        end
    end

    savedCollide = {}
end

--==================================================
-- CAMERA
--==================================================

local function setFloatCamera(on)
    local cam = Workspace.CurrentCamera
    if not cam then return end

    cam.CameraType = Enum.CameraType.Custom

    if on and marker then
        cam.CameraSubject = marker
    elseif humanoid then
        cam.CameraSubject = humanoid
    end
end

--==================================================
-- GROUND DETECTION
--==================================================

local function probeTop(x, z)
    local result = Workspace:Blockcast(
        CFrame.new(x, markerY + 1, z),
        MARKER_SIZE,
        Vector3.new(0, -600, 0),
        rayParams
    )

    if result then
        return result.Position.Y
    end

    return -math.huge
end

local function blockingTop(x, z)
    local parts = Workspace:GetPartBoundsInBox(
        CFrame.new(x, markerY + 20.5, z),
        COLUMN_SIZE,
        overlapParams
    )

    local highest = nil

    for _, part in ipairs(parts) do
        if part.CanCollide then
            local top = part.Position.Y + part.Size.Y / 2

            if not highest or top > highest then
                highest = top
            end
        end
    end

    return highest
end

--==================================================
-- MARKER MOVEMENT
--==================================================

local function tryMove(delta)
    local nx = markerX + delta.X
    local nz = markerZ + delta.Z

    local top = blockingTop(nx, nz)

    if not top or top <= markerY + 0.5 then
        markerX = nx
        markerZ = nz
        return
    end

    if top - markerY <= STEP_HEIGHT then
        markerX = nx
        markerZ = nz
        markerY = top + MARKER_SIZE.Y / 2
    end
end

--==================================================
-- TOUCH TELEPORT
--==================================================

local function floatTeleportTo(screenX, screenY)
    if not floatOn or not marker then return end

    local cam = Workspace.CurrentCamera
    if not cam then return end

    local ray = cam:ViewportPointToRay(
        screenX,
        screenY
    )

    local hit = Workspace:Raycast(
        ray.Origin,
        ray.Direction * 2000,
        rayParams
    )

    if not hit then return end

    markerX = hit.Position.X
    markerZ = hit.Position.Z
    markerY = hit.Position.Y + MARKER_SIZE.Y / 2

    jumpOffset = 0
end

--==================================================
-- START FLOAT
--==================================================

local function startFloat()
    if floatOn or rising or not root or not humanoid then
        return
    end

    local torso =
        character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")

    local spawnPos = torso and torso.Position or root.Position

    baseY = root.Position.Y

    markerX, markerY, markerZ =
        spawnPos.X, baseY, spawnPos.Z

    jumpOffset = 0
    floatOn = true

    humanoid.PlatformStand = true

    disableFloatCollide()
    createMarker()

    local cf = root.CFrame

    root.CFrame =
        CFrame.new(
            markerX,
            markerY - distance,
            markerZ
        ) * (cf - cf.Position)

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    setFloatCamera(true)
    refreshFloatStatus()
end

--==================================================
-- STOP FLOAT
--==================================================

local function stopFloat()
    if not floatOn or not root then return end

    floatOn = false
    rising = true
    jumpOffset = 0

    rootY = root.Position.Y

    targetRootY = math.max(
        baseY,
        probeTop(markerX, markerZ) + 3
    )

    refreshFloatStatus()
end

--==================================================
-- FINISH RISING
--==================================================

local function finishRise()
    rising = false
    jumpOffset = 0

    restoreFloatCollide()

    if humanoid then
        humanoid.PlatformStand = false

        humanoid:ChangeState(
            Enum.HumanoidStateType.GettingUp
        )
    end

    removeMarker()
    setFloatCamera(false)
    refreshFloatStatus()
end

